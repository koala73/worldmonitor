ge":5,"text":"d)","x":90.02,"y":502.51,"width":9.8},{"page":5,"text":"Asian LPG demand remained firm ahead of winter, supported by higher Chinese","x":108.02,"y":502.51,"width":389.9},{"page":5,"text":"PDH utilization and a 73% month-on-month increase in China's LPG imports. Indian","x":108.02,"y":487.87,"width":407.61},{"page":5,"text":"buyers also resumed spot procurement in August 2026.","x":108.02,"y":473.11,"width":269.62},{"page":5,"text":"e)","x":90.02,"y":458.47,"width":9.8},{"page":5,"text":"Shipping and supply constraints persisted, as Saudi Arabia shifted LPG shipments","x":108.02,"y":458.47,"width":399.96},{"page":5,"text":"toward Red Sea ports and relied on shuttle and ship-to-ship operations to maintain","x":108.02,"y":443.83,"width":401.2},{"page":5,"text":"cargo flows.","x":108.02,"y":428.11,"width":58.74},{"page":5,"text":"1","x":166.7,"y":428.11,"width":6.08},{"page":5,"text":"coming months.","x":72.02,"y":364.25,"width":77.69},{"page":5,"text":"These international market forces impacted the price of Butane and","x":152.66,"y":364.25,"width":327.69},{"page":5,"text":"prices in Fiji in October 2026.","x":72.02,"y":334.85,"width":142.47},{"page":5,"text":"Enforcement and Compliance","x":72.02,"y":312.29,"width":155.4},{"page":5,"text":"non-compliance are encouraged to report the matter to FCCC.","x":72.02,"y":183.02,"width":318.07},{"page":5,"text":"The Central team can be","x":394.87,"y":183.02,"width":128.63},{"page":5,"text":"1","x":72.02,"y":98.78,"width":3.24},{"page":6,"text":"Complaints can be","x":430.99,"y":759.6,"width":92.66},{"page":6,"text":"emailed to","x":72.02,"y":744.94,"width":50.88},{"page":6,"text":"helpdesk@fccc.gov.fj","x":125.9,"y":744.94,"width":103.36},{"page":6,"text":", or lodged through the FCCC website at","x":229.25,"y":744.94,"width":196.79},{"page":6,"text":"www.fccc.gov.fj","x":429.19,"y":744.94,"width":74.42},{"page":6,"text":".","x":503.62,"y":744.94,"width":3.07},{"page":6,"text":"throughout October.","x":72.02,"y"