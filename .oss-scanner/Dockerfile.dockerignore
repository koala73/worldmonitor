# Used instead of the root .dockerignore when building .oss-scanner/Dockerfile.
# The root file drops tests/, e2e/ and most Markdown for the slim self-hosting
# image; the scanner needs them. Only build output and local secrets stay out.
**/node_modules
dist
src-tauri/target
src-tauri/sidecar/node
.worktrees
.env*
!.env.example
*.key
*.pem
secrets/
docker-compose.override.yml
