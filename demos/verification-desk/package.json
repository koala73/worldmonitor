{
  "name": "worldmonitor-verification-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Live stage demo: an AI anchor grades headlines against WorldMonitor's publisher-family counts.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "rehearse": "DESK_REHEARSAL=1 node server.mjs",
    "grade": "node scripts/grade.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot:loop": "node scripts/snapshot.mjs --every=30",
    "find-reveal": "node scripts/find-reveal.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1"
  }
}
