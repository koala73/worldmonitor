# Copy to .env and fill in. Never commit .env.

# WorldMonitor MCP (required for live data). A Pro API key from worldmonitor.app.
WORLDMONITOR_API_KEY=
# Alternatively an OAuth bearer token for /mcp:
# WORLDMONITOR_MCP_TOKEN=
# WORLDMONITOR_MCP_URL=https://worldmonitor.app/mcp

# Anchor voice (Claude). Without it the anchor speaks fixed templates.
ANTHROPIC_API_KEY=
# ANCHOR_MODEL=claude-opus-5-5
# ANCHOR_EFFORT=low

# Optional: ElevenLabs voice. Without it the browser's built-in voice speaks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: talking-head avatar page to frame in the anchor slot
# (e.g. a HeyGen or Tavus conversation URL). Leave empty for the built-in anchor.
DESK_AVATAR_EMBED_URL=

# Live map behind the anchor. Set to empty to use a plain backdrop (no network).
# DESK_BACKDROP_URL=https://worldmonitor.app/embed?theme=dark

# Seconds between check reveals on stage (ms)
# DESK_STEP_DELAY_MS=1400
