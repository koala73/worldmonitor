# Copy to .env and fill in. Never commit .env.

# WorldMonitor MCP (required for live data). A Pro API key from worldmonitor.app.
WORLDMONITOR_API_KEY=
# Alternatively an OAuth bearer token for /mcp:
# WORLDMONITOR_MCP_TOKEN=
# WORLDMONITOR_MCP_URL=https://worldmonitor.app/mcp

# Anchor voice (Claude). Without it the anchor speaks fixed templates.
ANTHROPIC_API_KEY=
# ANCHOR_MODEL=claude-opus-5-5
# ANCHOR_EFFORT=low

# Optional: ElevenLabs voice. Without it the browser's built-in voice speaks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: HeyGen LiveAvatar talking head (https://www.liveavatar.com). Its own
# API key and credits, separate from a HeyGen video API plan. FULL mode: the
# avatar speaks the anchor's exact lines in the LiveAvatar voice you pick.
# Press A on stage to switch between the avatar and the globe.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
# LIVEAVATAR_CONTEXT_ID=
# LIVEAVATAR_LANGUAGE=en
# If LiveAvatar rejects the session request, paste the exact JSON body from
# their docs here and it is sent as-is:
# LIVEAVATAR_TOKEN_BODY={"mode":"FULL","avatar_id":"...","avatar_persona":{"voice_id":"...","language":"en"}}

# Live map behind the anchor. Set to empty to use a plain backdrop (no network).
# DESK_BACKDROP_URL=https://worldmonitor.app/embed?theme=dark

# Minutes between board refreshes (2 WorldMonitor calls each)
# DESK_BOARD_REFRESH_MIN=15

# Seconds between check reveals on stage (ms)
# DESK_STEP_DELAY_MS=1400
