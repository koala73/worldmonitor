# Copy to .env and fill in. Never commit .env.

# WorldMonitor MCP (required for live data). A Pro API key from worldmonitor.app.
WORLDMONITOR_API_KEY=
# Alternatively an OAuth bearer token for /mcp:
# WORLDMONITOR_MCP_TOKEN=
# WORLDMONITOR_MCP_URL=https://worldmonitor.app/mcp

# Anchor voice (Claude). Without it the anchor speaks fixed templates.
ANTHROPIC_API_KEY=
# ANCHOR_MODEL=claude-opus-5-5
# ANCHOR_EFFORT=low

# Optional: ElevenLabs voice. Without it the browser's built-in voice speaks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: HeyGen LiveAvatar talking head. Its own key, from
# https://app.liveavatar.com/developers (a HeyGen video API key is a different
# product). FULL mode: the avatar says the desk's exact lines. Press G in the
# deck (A on /desk) to switch between the avatar and the globe.
# `npm run check` lists your avatar and voice ids.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Required for image avatars, optional for video avatars:
LIVEAVATAR_VOICE_ID=
# A context is required (without one the avatar is silent). Leave empty and
# the desk creates one once and caches it in data/liveavatar-context.json.
# LIVEAVATAR_CONTEXT_ID=
# LIVEAVATAR_LANGUAGE=en
# 1 = LiveAvatar's free sandbox avatar, ~1 minute sessions, for testing:
# LIVEAVATAR_SANDBOX=1
# If LiveAvatar rejects the session request, paste the exact JSON body here:
# LIVEAVATAR_TOKEN_BODY={"mode":"FULL","avatar_id":"...","avatar_persona":{"voice_id":"...","context_id":"...","language":"en"}}

# Live map behind the anchor. Set to empty to use a plain backdrop (no network).
# DESK_BACKDROP_URL=https://worldmonitor.app/embed?theme=dark   (off = no backdrop)

# Minutes between board refreshes (2 WorldMonitor calls each)
# DESK_BOARD_REFRESH_MIN=15

# Seconds between check reveals on stage (ms)
# DESK_STEP_DELAY_MS=1400

# The desk listens on localhost only: its routes spend your keys and allowance.
# Set to 0.0.0.0 only on a network you trust (e.g. a second screen on the LAN).
# DESK_HOST=127.0.0.1
