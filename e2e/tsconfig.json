{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "webmcp-types"],
    "tsBuildInfoFile": "../node_modules/.cache/tsconfig.e2e.tsbuildinfo",
    "paths": {
      "@/*": ["../src/*"],
      "/src/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "../src/**/*.d.ts"]
}
