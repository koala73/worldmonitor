---
import productFacts from '../../../shared/product-facts.generated.json';
import TrackedProductLink from '../components/TrackedProductLink.astro';

interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  keywords?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonicalUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  jsonLd?: Record<string, unknown>;
  breadcrumbLd?: Record<string, unknown>;
  faqLd?: Record<string, unknown>;
  attributionCampaign?: string;
}

const { title, description, metaTitle, keywords, ogType, ogImage, ogImageAlt, canonicalUrl, publishedTime, modifiedTime, author, section, jsonLd, breadcrumbLd, faqLd, attributionCampaign } = Astro.props;
const pageTitle = metaTitle || title;
const resolvedOgImage = ogImage || 'https://www.worldmonitor.app/favico/og-image.png';
const resolvedOgImageAlt = ogImageAlt || pageTitle;
const resolvedOgImageType = resolvedOgImage.toLowerCase().split(/[?#]/)[0].endsWith('.png')
  ? 'image/png'
  : 'image/jpeg';
const resolvedOgType = ogType || 'website';
const keywordTags = keywords ? keywords.split(',').map(k => k.trim()).slice(0, 6) : [];
const resolvedCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, 'https://www.worldmonitor.app').href;
const proCtaUrl = productFacts.product.pricingUrl;
const proCtaLabel = productFacts.product.primaryCtaLabel;

function stringifyJsonLd(value: Record<string, unknown>): string {
  return JSON.stringify(value).replace(/</g, '\\u003c');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={author || 'World Monitor'} />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={resolvedCanonicalUrl} />

    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:site_name" content="World Monitor Blog" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={resolvedOgImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {resolvedOgType === 'article' && <meta property="article:publisher" content="https://www.worldmonitor.app" />}
    {section && <meta property="article:section" content={section} />}
    {keywordTags.map(tag => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:site" content="@worldmonitorai" />
    <meta name="twitter:creator" content="@worldmonitorai" />

    <link rel="icon" type="image/x-icon" href="/favico/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favico/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favico/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favico/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="World Monitor Blog" href="https://www.worldmonitor.app/blog/rss.xml" />

    {jsonLd && (
      <script type="application/ld+json" set:html={stringifyJsonLd(jsonLd)} />
    )}
    {breadcrumbLd && (
      <script type="application/ld+json" set:html={stringifyJsonLd(breadcrumbLd)} />
    )}
    {faqLd && (
      <script type="application/ld+json" set:html={stringifyJsonLd(faqLd)} />
    )}

    <style is:global>
      @import '../styles/global.css';
    </style>

    <script defer src="https://abacus.worldmonitor.app/script.js" data-website-id="e8800335-c853-46a8-8497-c993ed2f58bc" data-domains="worldmonitor.app,www.worldmonitor.app,tech.worldmonitor.app,finance.worldmonitor.app,commodity.worldmonitor.app,happy.worldmonitor.app"></script>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/blog/" class="logo">
          <img src="/favico/favicon-32x32.png" alt="World Monitor" width="28" height="28" class="logo-icon-img" />
          <div class="logo-text">
            <span class="logo-name">WORLD MONITOR</span>
            <span class="logo-sub">by Someone.ceo</span>
          </div>
        </a>
        <ul class="nav-links">
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/blog/glossary/">Glossary</a></li>
          <li>
            <TrackedProductLink destination="dashboard" placement="header-dashboard" campaign={attributionCampaign}>
              Dashboard
            </TrackedProductLink>
          </li>
          <li>
            <TrackedProductLink destination="pro" placement="header-pro" campaign={attributionCampaign}>
              Pro
            </TrackedProductLink>
          </li>
          <li><a href="https://www.worldmonitor.app/docs" target="_blank" rel="noopener noreferrer">Docs</a></li>
          <li><a href="https://github.com/koala73/worldmonitor" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
        <TrackedProductLink
          destination="pro"
          href={proCtaUrl}
          placement="header-primary"
          campaign={attributionCampaign}
          class="nav-cta"
        >
          {proCtaLabel}
        </TrackedProductLink>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/favico/favicon-32x32.png" alt="" width="28" height="28" class="footer-icon-img" />
          <div class="footer-brand-text">
            <span class="footer-name">WORLD MONITOR</span>
            <span class="footer-sub">by Someone.ceo</span>
          </div>
        </div>
        <div class="footer-links">
          <a href="/blog/authors/elie-habib/">About</a>
          <TrackedProductLink destination="dashboard" placement="footer-dashboard" campaign={attributionCampaign}>
            Dashboard
          </TrackedProductLink>
          <TrackedProductLink destination="pro" placement="footer-pro" campaign={attributionCampaign}>
            Pro
          </TrackedProductLink>
          <TrackedProductLink destination="api" placement="footer-api" campaign={attributionCampaign}>
            API
          </TrackedProductLink>
          <TrackedProductLink destination="mcp" placement="footer-mcp" campaign={attributionCampaign}>
            MCP
          </TrackedProductLink>
          <a href="https://www.worldmonitor.app/docs" target="_blank" rel="noopener noreferrer">Docs</a>
          <a href="https://status.worldmonitor.app/" target="_blank" rel="noopener noreferrer">Status</a>
          <a href="https://github.com/koala73/worldmonitor" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://discord.gg/re63kWKxaz" target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="https://x.com/worldmonitorai" target="_blank" rel="noopener noreferrer">X</a>
        </div>
        <div class="footer-copy">
          &copy; {new Date().getFullYear()} World Monitor
        </div>
      </div>
    </footer>

    <!-- Keep inbound acquisition context on every tracked content handoff.
         Internal content fields use wm_content_*; affiliate ref params are
         intentionally outside this allowlist. -->
    <script is:inline nonce="wm-static-bootstrap">
      (() => {
        const utmParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        const incoming = new URLSearchParams(window.location.search);
        if (!utmParams.some((name) => incoming.has(name))) return;

        document.querySelectorAll('a[data-wm-content-link]').forEach((anchor) => {
          const href = anchor.getAttribute('href');
          if (!href) return;
          const target = new URL(href, window.location.href);
          for (const name of utmParams) {
            if (target.searchParams.has(name)) continue;
            const value = incoming.get(name);
            if (value !== null) target.searchParams.set(name, value.slice(0, 100));
          }
          anchor.setAttribute('href', target.toString());
        });
      })();
    </script>
  </body>
</html>
