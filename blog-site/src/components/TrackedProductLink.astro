---
import {
  BLOG_CONVERSION_EVENT,
  BLOG_CONVERSION_MEDIUM,
  BLOG_CONVERSION_SOURCE,
  buildBlogProductLinkUrl,
  normalizeBlogAttributionToken,
  type BlogProductDestination,
} from '../lib/blog-conversion-attribution';

interface Props {
  destination: BlogProductDestination;
  href?: string;
  placement: string;
  campaign?: string;
  class?: string;
}

const {
  destination,
  href,
  placement,
  campaign,
  class: className,
} = Astro.props;
const normalizedCampaign = normalizeBlogAttributionToken(campaign, 'blog-site');
const normalizedPlacement = normalizeBlogAttributionToken(placement, 'product-link');
const linkHref = buildBlogProductLinkUrl(destination, normalizedPlacement, normalizedCampaign, href);
---

<a
  href={linkHref}
  class={className}
  target="_blank"
  rel="noopener noreferrer"
  data-wm-content-link
  data-umami-event={BLOG_CONVERSION_EVENT}
  data-umami-event-destination={destination}
  data-umami-event-placement={normalizedPlacement}
  data-umami-event-campaign={normalizedCampaign}
  data-umami-event-source={BLOG_CONVERSION_SOURCE}
  data-umami-event-medium={BLOG_CONVERSION_MEDIUM}
  data-umami-event-content-source={BLOG_CONVERSION_SOURCE}
  data-umami-event-content-medium={BLOG_CONVERSION_MEDIUM}
  data-umami-event-content-campaign={normalizedCampaign}
  data-umami-event-content-destination={destination}
  data-umami-event-content-placement={normalizedPlacement}
  data-umami-event-article={normalizedCampaign}
>
  <slot />
</a>
