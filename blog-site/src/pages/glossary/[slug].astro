---
import Base from '../../layouts/Base.astro';
import { GLOSSARY_TERMS, PIZZINT_LEVELS } from '../../data/glossary';

export function getStaticPaths() {
  return GLOSSARY_TERMS.map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

const { term } = Astro.props;
const bySlug = new Map(GLOSSARY_TERMS.map((t) => [t.slug, t]));
const related = term.related.map((slug) => bySlug.get(slug)).filter((t) => t != null);

const pageUrl = `https://www.worldmonitor.app/blog/glossary/${term.slug}/`;
const termLabel = `${term.term}${term.abbr ? ` (${term.abbr})` : ''}`;
const metaTitle = term.abbr
  ? `${term.abbr} Definition | World Monitor`
  : `${term.term} Definition | World Monitor`;
const titleTag = term.metaTitle ?? metaTitle;
const description = term.metaDescription ?? term.short;
const metaDescription = description.length <= 160
  ? description
  : `${description.slice(0, 157).replace(/\s+\S*$/, '')}...`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: `What is ${termLabel}?`,
  description: metaDescription,
  inLanguage: 'en-US',
  isPartOf: { '@id': 'https://www.worldmonitor.app/#website' },
  publisher: { '@id': 'https://www.worldmonitor.app/#organization' },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.glossary-lede'],
  },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  mainEntity: {
    '@type': 'DefinedTerm',
    name: term.term,
    ...(term.abbr ? { alternateName: term.abbr } : {}),
    description: term.short,
    url: pageUrl,
    inLanguage: 'en-US',
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      name: 'World Monitor Global Intelligence Glossary',
      url: 'https://www.worldmonitor.app/blog/glossary/',
    },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.worldmonitor.app/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.worldmonitor.app/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Glossary', item: 'https://www.worldmonitor.app/blog/glossary/' },
    { '@type': 'ListItem', position: 4, name: term.term, item: pageUrl },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `What is ${term.term}${term.abbr ? ` (${term.abbr})` : ''}?`,
      acceptedAnswer: { '@type': 'Answer', text: term.short },
    },
    ...(term.faq ?? []).map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  ],
};
---

<Base
  title={`What is ${termLabel}?`}
  description={metaDescription}
  metaTitle={titleTag}
  ogType="website"
  jsonLd={jsonLd}
  breadcrumbLd={breadcrumbLd}
  faqLd={faqLd}
>
  <article class="glossary-term">
    <nav class="glossary-breadcrumb" aria-label="Breadcrumb">
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/glossary/">Glossary</a>
      <span aria-hidden="true">/</span>
      <span>{term.term}</span>
    </nav>

    <header class="glossary-term-header">
      <div class="glossary-term-cat">{term.category}</div>
      <h1>
        {term.term}
        {term.abbr && <span class="glossary-abbr">{term.abbr}</span>}
      </h1>
      <p class="glossary-lede">{term.short}</p>
    </header>

    {term.liveReading === 'pizzint' && (
      <section class="live-reading" data-live-pizzint data-state="loading" aria-labelledby="live-reading-heading">
        <div class="live-reading-head">
          <h2 id="live-reading-heading">Current level</h2>
          <span class="live-reading-status" data-live-status>Loading the live level…</span>
        </div>
        <p class="live-reading-fallback" data-live-fallback>
          The current level loads in your browser from World Monitor’s live feed, refreshed every 15 minutes.
          It also appears next to the pizza icon in the <a href="/dashboard">dashboard header</a>.
        </p>
        <div class="live-reading-body" data-live-grid hidden aria-busy="true">
          <p class="live-reading-level">
            <strong data-pizzint-level>—</strong>
            <span data-pizzint-label></span>
          </p>
          <ul class="live-reading-venues" data-pizzint-venues></ul>
        </div>
        <div class="live-reading-foot">
          <time data-live-updated></time>
          <button type="button" data-live-refresh>Refresh</button>
        </div>
      </section>
    )}

    <div class="prose">
      {term.body.map((para) => (
        <p>{para}</p>
      ))}
    </div>

    {term.liveReading === 'pizzint' && (
      <div class="glossary-levels">
        <h2>Levels</h2>
        <table>
          <thead>
            <tr><th scope="col">Level</th><th scope="col">Activity</th><th scope="col">Index points</th></tr>
          </thead>
          <tbody>
            {PIZZINT_LEVELS.map((row) => (
              <tr><td>{row.level}</td><td>{row.label}</td><td>{row.points}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {term.faq && term.faq.length > 0 && (
      <div class="glossary-faq">
        {term.faq.map((item) => (
          <section>
            <h2>{item.question}</h2>
            <p>{item.answer}</p>
          </section>
        ))}
      </div>
    )}

    {term.learnMore && term.learnMore.length > 0 && (
      <div class="glossary-learn">
        <h2>Learn more</h2>
        <ul>
          {term.learnMore.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    {related.length > 0 && (
      <div class="glossary-related">
        <h2>Related terms</h2>
        <div class="glossary-related-grid">
          {related.map((t) => (
            <a href={`/blog/glossary/${t.slug}/`} class="glossary-card">
              <h3>
                {t.term}
                {t.abbr && <span class="glossary-abbr">{t.abbr}</span>}
              </h3>
              <p>{t.short}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="cta-banner glossary-cta">
      <h3>See it live</h3>
      <p>
        World Monitor tracks this and hundreds of other signals in real time on one map —
        free, no account required.
      </p>
      <a href="https://www.worldmonitor.app" class="btn" target="_blank" rel="noopener noreferrer">
        Open Dashboard
      </a>
    </div>
  </article>

  {term.liveReading && (
    <script type="module" is:inline nonce="wm-static-bootstrap" src="/tools/live-tools.js"></script>
  )}

  <style>
    .live-reading {
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 1rem 1.1rem;
      margin: 0 0 2rem;
    }
    .live-reading-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .live-reading-head h2 {
      margin: 0;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .live-reading-status {
      font-size: 0.8rem;
      opacity: 0.75;
    }
    .live-reading-fallback {
      margin: 0.75rem 0 0;
      font-size: 0.9rem;
      opacity: 0.85;
    }
    .live-reading-level {
      margin: 0.75rem 0;
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .live-reading-level strong {
      font-size: 2rem;
      line-height: 1;
      color: var(--wm-green, #4ade80);
    }
    .live-reading-venues {
      margin: 0;
      padding-left: 1.1rem;
      font-size: 0.9rem;
    }
    .live-reading-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.75rem;
      font-size: 0.8rem;
      opacity: 0.75;
    }
    .live-reading-foot button {
      font: inherit;
      color: inherit;
      background: transparent;
      border: 1px solid currentColor;
      border-radius: 6px;
      padding: 0.25rem 0.7rem;
      cursor: pointer;
    }
    .live-reading-foot button:disabled {
      opacity: 0.5;
      cursor: default;
    }
    .glossary-levels,
    .glossary-faq {
      margin-top: 2.5rem;
    }
    .glossary-levels h2,
    .glossary-faq h2 {
      font-size: 1.1rem;
      margin: 0 0 0.5rem;
    }
    .glossary-faq section + section {
      margin-top: 1.75rem;
    }
    .glossary-faq p {
      margin: 0;
    }
    .glossary-levels table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .glossary-levels th,
    .glossary-levels td {
      text-align: left;
      padding: 0.45rem 0.75rem 0.45rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .glossary-term {
      max-width: 720px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
    }
    .glossary-breadcrumb {
      font-size: 0.8rem;
      opacity: 0.65;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    .glossary-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }
    .glossary-breadcrumb a:hover {
      color: var(--wm-green, #4ade80);
    }
    .glossary-term-cat {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--wm-green, #4ade80);
      margin-bottom: 0.5rem;
    }
    .glossary-term-header h1 {
      margin: 0 0 0.75rem;
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .glossary-lede {
      font-size: 1.1rem;
      line-height: 1.5;
      opacity: 0.9;
      margin: 0 0 1.5rem;
    }
    .glossary-abbr {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--wm-green, #4ade80);
      border: 1px solid currentColor;
      border-radius: 4px;
      padding: 0.1rem 0.4rem;
    }
    .glossary-learn,
    .glossary-related {
      margin-top: 2.5rem;
    }
    .glossary-learn h2,
    .glossary-related h2 {
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      opacity: 0.8;
    }
    .glossary-related-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    .glossary-card {
      display: block;
      padding: 1rem 1.1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .glossary-card:hover {
      border-color: var(--wm-green, #4ade80);
      transform: translateY(-2px);
    }
    .glossary-card h3 {
      margin: 0 0 0.4rem;
      font-size: 0.95rem;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .glossary-card p {
      margin: 0;
      font-size: 0.82rem;
      line-height: 1.45;
      opacity: 0.75;
    }
    .glossary-cta {
      margin-top: 3rem;
    }
  </style>
</Base>
