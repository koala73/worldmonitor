{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2021"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/convex-tsconfig.tsbuildinfo",
    "outDir": "./_generated"
  },
  "include": ["./**/*.ts"],
  "exclude": ["./_generated", "./__tests__"]
}
