api/data/city-coords.js
convex/_generated/**/*.js

# OpenAPI bundle copied at build time from docs/api/ for native Vercel serve
/public/openapi.yaml
# JSON mirror of the bundle (build:openapi → scripts/build-openapi-json.mjs);
